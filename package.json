{
  "name": "vue-tinder",
  "version": "3.0.0",
  "description": "Tinder-like card swiping component for Vue 3",
  "main": "dist/vue-tinder.js",
  "type": "module",
  "module": "dist/vue-tinder.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-tinder.mjs",
      "require": "./dist/vue-tinder.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "JohnnyDan",
    "email": "shanlh841271734@live.com"
  },
  "contributors": [],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cucumber": "vitest --config vitest.config.js __tests__/steps",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "tinder",
    "tantan",
    "vue",
    "vue3",
    "composables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanlh/vue-tinder.git"
  },
  "homepage": "https://github.com/shanlh/vue-tinder",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "4.7.0",
    "@cucumber/cucumber": "^10.0.1",
    "@testing-library/vue": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.1",
    "jsdom": "^23.0.1",
    "typescript": "^5.1.6",
    "vite": "^6.2.5",
    "vite-plugin-dts": "^3.3.1",
    "vite-plugin-vue-mcp": "^0.3.2",
    "vitepress": "^1.0.0-rc.4",
    "vitest": "^3.1.1"
  }
}
